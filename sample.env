# Bot Configuration
BOT_TOKEN=
MESSAGE_DUMP=
OWNER_ID=

# Telegram Bot API Server (Optional)
# For a local telegram-bot-api server (with docker-compose.yml, add API_SERVER to the alita service's environment: block)
# API_SERVER=http://telegram-bot-api:8081

# PostgreSQL Configuration
# Format: postgres://username:password@host:port/database?sslmode=disable
DATABASE_URL=postgres://postgres:password@localhost:5432/alita_robot?sslmode=disable

# Database Connection Pool Configuration (Optional)
# These settings control database connection pooling for optimal performance
# Optimized for high-performance deployments

# Maximum number of idle connections in the pool
# Default: 50 connections
# Recommended: 30-80 depending on deployment size (small/medium/large)
#DB_MAX_IDLE_CONNS=50

# Maximum number of open connections to the database
# Default: 200 connections
# Optimized: 200 connections for handling burst traffic
# Recommended: 150-400 depending on deployment size
# Small deployment: 100, Medium: 200, Large: 300-400
#DB_MAX_OPEN_CONNS=200

# Maximum amount of time a connection can be reused (in minutes)
# Default: 240 minutes (4 hours)
# Recommended: 120-480 minutes depending on database server settings
#DB_CONN_MAX_LIFETIME_MIN=240

# Maximum amount of time a connection can be idle (in minutes)
# Default: 60 minutes
# Recommended: 30-60 minutes depending on connection patterns
#DB_CONN_MAX_IDLE_TIME_MIN=60

# Redis Configuration
# Option 1: Direct address (recommended for self-hosted)
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=
REDIS_DB=1
# Option 2: Redis URL, as set by Heroku/Railway add-ons. Used only when
# REDIS_ADDRESS is unset; rediss:// connects over TLS.
# REDIS_URL=redis://user:password@host:port
# Skip TLS certificate verification for a rediss:// REDIS_URL. Heroku Redis
# needs it (self-signed certificate); leave false everywhere else.
# Default: false
#REDIS_TLS_INSECURE_SKIP_VERIFY=false

# Webhook Configuration (set USE_WEBHOOKS=true to enable)
USE_WEBHOOKS=false
WEBHOOK_DOMAIN=https://your-bot-domain.com
WEBHOOK_SECRET=your-random-secret-string

# HTTP Server Configuration
# Single port for health, metrics, and webhook endpoints
HTTP_PORT=8080

# Other settings
ENABLED_LOCALES=en
DEBUG=false
DROP_PENDING_UPDATES=false

# Maximum concurrent goroutines for the update dispatcher
# Controls how many updates can be processed simultaneously
# Default: 200 goroutines
# Optimized: 200 goroutines for better throughput
# Recommended values:
# - Low-resource environments: 50-100 to prevent memory issues
# - Standard deployment: 200 (optimized default)
# - High-traffic bots: 300-500 for maximum throughput
# - Development/testing: 10 for easier debugging
#DISPATCHER_MAX_ROUTINES=200

# Monitoring and Statistics (Optional)
# Enable performance monitoring and background statistics collection

# Enable automatic performance monitoring and alerting
# Default: true in production (when DEBUG=false), false in debug mode
# Set to true to enable detailed performance tracking
#ENABLE_PERFORMANCE_MONITORING=true

# Enable background statistics collection
# Default: true in production (when DEBUG=false), false in debug mode
# Set to true to collect system metrics in the background
#ENABLE_BACKGROUND_STATS=true

# Log database connection pool stats every minute (debug level: visible only with DEBUG=true).
# /db_metrics is always available regardless of this flag
# Default: false
#ENABLE_DB_MONITORING=false

# Enable pprof profiling endpoints (DEVELOPMENT ONLY!)
# WARNING: Never enable this in production - exposes internal runtime information
# When enabled, provides /debug/pprof/* endpoints for CPU, memory, goroutine analysis
# Use for debugging performance issues in development/staging only
# Default: false
#ENABLE_PPROF=false

# Metrics endpoint authentication token
# When set, /metrics and /db_metrics require "Authorization: Bearer <token>"
# (constant-time comparison is used to prevent timing attacks)
# When unset, the endpoints are accessible without authentication and a warning is logged
# Recommended: set to a long random string in production to protect operational telemetry
# Example: METRICS_AUTH_TOKEN=your-random-secret-token
#METRICS_AUTH_TOKEN=

# ============ AI Spam Filter (Optional) ============
# Per-chat AI spam filter backed by TypeSafe Jev. The filter is off in every
# chat until an admin runs /aispam on, and inert until TYPESAFE_API_KEY is set.

# TypeSafe API key used for every AI spam check
# Single credential for the whole bot; chats cannot bring their own
# Get one at https://typesafe.ai
#TYPESAFE_API_KEY=

# Global kill switch for the AI spam filter
# Default: true (the feature still stays off in chats that never enabled it)
# Set to false to stop all AI spam checks without deploying
#ENABLE_AISPAM=true

# ============ Spam Database Join Check (Optional) ============
# Per-chat check of new members against the CAS (cas.chat) spam database and,
# for chats that opt in with /spamdb db lols on, lols.bot. The check is off in
# every chat until an admin runs /spamdb on; when on, each new member's
# Telegram user ID is sent to each database the chat selected.

# Operator kill switch for the check
# Default: true (the check still stays off in chats that never enabled it)
# Set to false to stop sending user IDs to CAS and lols.bot from every chat
#ENABLE_SPAMDB=true

# Optional CAS API key, sent as "Authorization: Bearer"
# CAS still accepts requests without one but has announced keys will become required
# Get one at https://cas.chat/api
#CAS_API_KEY=

# ============ Shared Reputation Network (Optional) ============
# Join check over the moderation actions this bot recorded: a user banned or
# kicked by several unrelated chats inside a rolling window is listed, and a
# human unban in a chat that banned or kicked them earlier in the window clears
# the signal (an unban in a chat that never removed them changes nothing). Only
# user IDs and moderation actions are stored, never message content. Every chat
# stays opted out until its spam database settings enable the shared source.

# Operator kill switch for shared reputation lookups
# Default: false
# Set to true to let chats use the shared source
#ENABLE_REPUTATION=false

# Distinct chats that must have banned or kicked the user to list them
# Default: 3; minimum 2. One chat banning a user many times counts once.
# A non-integer or a value below 2 fails startup
#REPUTATION_MIN_CHATS=3

# Rolling window in days
# Default: 30; maximum 180 (the moderation event retention, after which old
# events are deleted). A non-integer or an out-of-range value fails startup
#REPUTATION_WINDOW_DAYS=30

# ============ Weekly Digest (Optional) ============
# Per-chat daily counters of messages, joins and leaves feed the weekly digest
# and the /digest preview. Counters are kept in memory and written to the
# database every 60 seconds; a crash loses at most the last minute. Admins opt
# a chat in with /digest on; the digest goes to the chat's log channel when it
# has one, otherwise to the group.

# Operator kill switch for the digest
# Default: true (chats still control their own digest settings with /digest)
# Set to false to stop all digests and refuse /digest
#ENABLE_DIGEST=true

# How often the scheduler looks for chats due a weekly digest
# Go duration syntax (e.g. 30m, 1h, 6h). Default: 1h
#DIGEST_INTERVAL=1h

# ============ Admin Panel (Telegram Mini App, Optional) ============
# Serves a small dashboard from this bot's HTTP server under /panel. Off by
# default: with PANEL_ENABLED unset or false, /panel and /panel/api/v1/* are 404
# and the bot behaves exactly as before.

# Enable the panel
# Requires PANEL_PUBLIC_URL, which must be https:// unless DEBUG=true
# Default: false
#PANEL_ENABLED=false

# Public origin the panel is served from (no trailing slash needed)
# Telegram Mini Apps require HTTPS. Point this at the same host as
# WEBHOOK_DOMAIN, or at the reverse proxy that forwards /panel to this server.
# Required when PANEL_ENABLED=true
#PANEL_PUBLIC_URL=https://bot.example.com

# Optional BotFather Mini App short name
# When set, group buttons open https://t.me/<bot>/<shortname>?startapp=chat_<id>
# directly instead of going through the /start panel_<id> PM deep link
#PANEL_MINIAPP_SHORTNAME=

# How old a Mini App initData payload may be before it is rejected
# Go duration syntax (e.g. 30m, 24h). Default: 24h
#PANEL_SESSION_MAX_AGE=24h

# Cache Configuration
# Read-through lookups keep a short-lived in-process copy in front of Redis.
# Seconds to serve a value from memory; other replicas may see a change this late.
# Default: 10 (0 disables the local layer, max 300)
#CACHE_LOCAL_TTL=10
# Maximum entries in the local layer (LRU). Default: 50000 (100-1000000)
#CACHE_LOCAL_MAX_ENTRIES=50000

# Clear disposable alita:cache:* entries on startup; operational state is preserved
# Default: false (preserve cached data and avoid a cold-start database spike)
#CLEAR_CACHE_ON_STARTUP=false

# Bypass the read-through cache: every lookup hits PostgreSQL and the bot starts
# even if Redis is unreachable (Redis-backed features degrade). For load testing only.
# Default: false
#DISABLE_CACHE=false

# ============ Activity Monitoring Configuration ============
# Number of days of inactivity before marking a chat as inactive
# Default: 30
# Recommended: 1-365 days (not enforced)
#INACTIVITY_THRESHOLD_DAYS=30

# Hours between automatic activity checks
# Default: 1 (checks every hour)
# Recommended: 1-24 hours (not enforced)
#ACTIVITY_CHECK_INTERVAL=1

# Enable automatic cleanup of inactive chats
# Default: true
# Set to false to disable automatic marking of inactive chats
#ENABLE_AUTO_CLEANUP=true

# ============ Performance Optimization Settings ============
# Advanced settings for high-performance deployments

# HTTP connection pool size
# Default: 100
# Maximum number of HTTP connections to maintain
#HTTP_MAX_IDLE_CONNS=100

# HTTP connection pool per host
# Default: 50
# Maximum connections per host (api.telegram.org)
#HTTP_MAX_IDLE_CONNS_PER_HOST=50

# ============ Resource Monitoring Limits ============
# Maximum goroutines before triggering cleanup
# Default: 1000
# Recommended: 1000-5000 depending on system resources
#RESOURCE_MAX_GOROUTINES=1000

# Maximum memory usage in MB before triggering cleanup
# Default: 500
# Recommended: 500-2000 depending on available RAM
#RESOURCE_MAX_MEMORY_MB=500

# Memory threshold for triggering garbage collection in MB
# Default: 400
# Recommended: 80% of RESOURCE_MAX_MEMORY_MB
#RESOURCE_GC_THRESHOLD_MB=400

# ============ Database Migration Settings ============
# Automatic database migration configuration

# Enable automatic database migrations on startup
# Default: false (for backward compatibility)
# Set to true to automatically apply SQL migrations when the bot starts
# This will create/update database tables based on files in migrations/
#AUTO_MIGRATE=false

# Continue running even if migrations fail
# Default: false (bot will exit if migrations fail)
# Set to true to log migration errors but continue running the bot
# WARNING: Only use this in development or if you're certain the schema is correct
#AUTO_MIGRATE_SILENT_FAIL=false

# Custom path to migration files (optional)
# Default: migrations
# Specify a different directory containing SQL migration files
# Useful for custom deployments or testing
#MIGRATIONS_PATH=migrations
