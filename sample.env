# ============ Required ============
BOT_TOKEN=
OWNER_ID=

# ============ Optional ============

# SQLite database file.
# Default production path is /data/alita.db (Docker volume).
# For local development you can point at a relative file such as ./alita.db.
#SQLITE_PATH=/data/alita.db

# Port for the HTTP server (health endpoint, and /webhook in webhook mode).
# PORT is honoured as a fallback for hosts that inject it.
#HTTP_PORT=8080

# Logging verbosity: panic, fatal, error, warn, info, debug, or trace.
#LOG_LEVEL=info

# Chat that receives startup notices. Leave unset to skip them.
#MESSAGE_DUMP=

# Update delivery. Polling is the default.
#USE_WEBHOOKS=false

# Required only when USE_WEBHOOKS is enabled.
#WEBHOOK_DOMAIN=https://your-bot-domain.com
#WEBHOOK_SECRET=your-random-secret-string

# TypeSafe AI API key for NSFW/curse words detection via /nsfw.
#TYPESAFE_API_KEY=

# Groups where /nsfw is available to all members. Separate multiple IDs with commas.
# Unset disables the command.
#OWNER_CHAT_IDS=-1001490301388
